# ---- Vapi ----
# Vapi dashboard -> API Keys -> Private key (keep secret)
VAPI_API_KEY=
# Vapi dashboard -> Assistants -> open your assistant -> copy its ID
VAPI_ASSISTANT_ID=
# Vapi dashboard -> Phone Numbers -> open the Twilio number -> copy its ID (not the +1 number)
VAPI_PHONE_NUMBER_ID=

# ---- Supabase ----
# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Dashboard login ----
# The password you will type on the login page
DASHBOARD_PASSWORD=
# Any long random text (40+ characters). Changing it logs everyone out.
AUTH_SECRET=

# ---- Calling rules (optional) ----
# How many new calls to start per minute (default 5)
CALLS_PER_MINUTE=5
# Calling window in UAE time (default 9 to 18 = 9am to 6pm)
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
# Set to false ONLY for testing on your own number outside 9am-6pm
BUSINESS_HOURS_ENFORCED=true
